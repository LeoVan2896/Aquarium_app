  "fixed_sql": [
    {
      "name": "tanks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tanks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"volume_gal\" REAL NOT NULL, \"substrate_type\" TEXT NOT NULL, \"has_soil\" INTEGER NOT NULL CHECK (\"has_soil\" IN (0, 1)), \"water_source\" TEXT NOT NULL, \"heater_watts\" REAL NULL, \"light_watts\" REAL NULL, \"light_hours_per_day\" REAL NULL, \"room_temp_f\" REAL NULL, \"target_temp_f\" REAL NULL, \"cycle_started_at\" INTEGER NULL, \"cycle_method\" TEXT NOT NULL, \"stocked_at\" INTEGER NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"light_level\" TEXT NULL, \"has_co2\" INTEGER NOT NULL DEFAULT 0 CHECK (\"has_co2\" IN (0, 1)), \"footprint_length_in\" REAL NULL, \"footprint_width_in\" REAL NULL);"
        }
      ]
    },
    {
      "name": "test_kits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"test_kits\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"brand\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "kit_parameters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"kit_parameters\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kit_id\" INTEGER NOT NULL REFERENCES test_kits (id), \"parameter\" TEXT NOT NULL, \"input_mode\" TEXT NOT NULL, \"steps_json\" TEXT NULL, \"unit\" TEXT NOT NULL, UNIQUE (\"kit_id\", \"parameter\"));"
        }
      ]
    },
    {
      "name": "readings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"readings\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"tank_id\" INTEGER NOT NULL REFERENCES tanks (id), \"kit_id\" INTEGER NULL REFERENCES test_kits (id), \"parameter\" TEXT NOT NULL, \"value\" REAL NOT NULL, \"unit\" TEXT NOT NULL, \"taken_at\" INTEGER NOT NULL, \"entered_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"corrects_id\" INTEGER NULL REFERENCES readings (id), \"note\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"tank_id\" INTEGER NOT NULL REFERENCES tanks (id), \"type\" TEXT NOT NULL, \"product\" TEXT NULL, \"amount\" REAL NULL, \"amount_unit\" TEXT NULL, \"percent_changed\" REAL NULL, \"occurred_at\" INTEGER NOT NULL, \"entered_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"corrects_id\" INTEGER NULL REFERENCES events (id), \"note\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminders\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"tank_id\" INTEGER NOT NULL REFERENCES tanks (id), \"every_n_days\" INTEGER NOT NULL, \"time_of_day\" TEXT NOT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"last_fired_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "stock_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stock_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"tank_id\" INTEGER NOT NULL REFERENCES tanks (id), \"species_id\" TEXT NOT NULL, \"species_type\" TEXT NOT NULL, \"change\" INTEGER NOT NULL, \"occurred_at\" INTEGER NOT NULL, \"entered_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"corrects_id\" INTEGER NULL REFERENCES stock_entries (id), \"note\" TEXT NULL);"
